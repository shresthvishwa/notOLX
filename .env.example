# Supabase Credentials (Optional for local testing - App runs seamlessly in Sandbox Mode without this)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Instant Email Notification Credentials (Optional - for real inbox email delivery via Gmail or SMTP)
# If left empty, notifications run in development mode with interactive test preview URLs.
# To receive real emails in your inbox, generate a 16-character Google App Password:
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a password named "notoLX"
# 3. Enter your Gmail and 16-character App password below:
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
