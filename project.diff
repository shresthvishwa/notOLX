+                              RESERVED
+                            </span>
+                          )}
+                          {item.status === 'sold' && (
+                            <span style={{ backgroundColor: 'rgba(139, 92, 246, 0.15)', color: '#8b5cf6', fontSize: '0.68rem', fontWeight: 800, padding: '0.1rem 0.4rem', borderRadius: 'var(--radius-full)' }}>
+                              SOLD
+                            </span>
+                          )}
