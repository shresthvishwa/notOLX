+                      marginTop: '0.2rem',
+                      fontSize: '0.78rem',
+                      color: 'var(--text-muted)',
+                      flexWrap: 'wrap',
+                      gap: '0.5rem'
+                    }}>
+                      <div style={{ display: 'flex', alignItems: 'center', gap: '0.85rem', flexWrap: 'wrap' }}>
