+                          <span style={{ fontSize: '0.72rem', color: 'var(--text-light)', fontWeight: 500 }}>
+                            (@thapar.edu)
+                          </span>
+                        </span>
+
+                        <span style={{ display: 'flex', alignItems: 'center', gap: '0.3rem' }}>
+                          <MapPin size={13} color="var(--primary)" />
