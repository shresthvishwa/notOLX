+              "{searchQuery}"
+            </span>
+          )}
+        </div>
+
+        {/* Filters Group */}
+        <div style={{ display: 'flex', alignItems: 'center', gap: '0.85rem', flexWrap: 'wrap' }}>
+          {/* Condition Dropdown Filter */}
