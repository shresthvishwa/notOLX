+                    <span>Make an Offer</span>
+                  </button>
+                </>
+              ) : (
+                /* Owner Actions */
+                <div style={{ display: 'flex', flexDirection: 'column', gap: '0.6rem' }}>
+                  <div style={{ fontSize: '0.8rem', fontWeight: 800, color: 'var(--text-muted)', textTransform: 'uppercase' }}>
